# 复制为 .env 后按需填写；全部留空时后端走离线分支，可无网络运行。
# 数据存储目录（默认为 backend/data）
DATA_DIR=./data

# 可选：OpenAI 摘要生成（留空则用确定性离线摘要）
OPENAI_API_KEY=

# 可选：pyannote 说话人区分（留空则用离线说话人划分）
PYANNOTE_AUTH_TOKEN=

# 可选：邮件（SMTP）。留空时 send-email 会如实返回未投递错误。
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_RECIPIENTS=
